{
  "name": "shelfwatch-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./src/generated.css",
    "dev": "npm run build:css && vite --host 0.0.0.0",
