    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0"
  }
}
